{
  "name": "local-microservices-overlay",
  "displayName": "Local Microservices Overlay",
  "description": "Real-time monitoring, health checks, live log streaming, and container lifecycle management for local Docker Compose microservices — directly within VS Code.",
  "version": "1.0.0",
  "publisher": "ChaninduImanjith",
  "author": {
    "name": "Chanindu Imanjith",
    "email": "chanindu.imanjith@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ChaninduImanjith/local-microservices-overlay.git"
  },
  "homepage": "https://github.com/ChaninduImanjith/local-microservices-overlay#readme",
  "bugs": {
    "url": "https://github.com/ChaninduImanjith/local-microservices-overlay/issues"
  },
  "keywords": [
    "docker",
    "microservices",
    "docker-compose",
    "containers",
    "monitoring",
    "devops",
    "logs"
  ],
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "activationEvents": [
    "onView:microservicesView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "microservices-explorer",
          "title": "Local Microservices",
          "icon": "$(server)"
        }
      ]
    },
    "views": {
      "microservices-explorer": [
        {
          "id": "microservicesView",
          "name": "Containers",
          "icon": "$(server)",
          "contextualTitle": "Local Microservices"
        }
      ]
    },
    "commands": [
      {
        "command": "local-microservices-overlay.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Microservices"
      },
      {
        "command": "local-microservices-overlay.startContainer",
        "title": "Start Container",
        "icon": "$(play)",
        "category": "Microservices"
      },
      {
        "command": "local-microservices-overlay.stopContainer",
        "title": "Stop Container",
        "icon": "$(debug-stop)",
        "category": "Microservices"
      },
      {
        "command": "local-microservices-overlay.restartContainer",
        "title": "Restart Container",
        "icon": "$(debug-restart)",
        "category": "Microservices"
      },
      {
        "command": "local-microservices-overlay.showLogs",
        "title": "Show Logs",
        "icon": "$(output)",
        "category": "Microservices"
      },
      {
        "command": "local-microservices-overlay.copyId",
        "title": "Copy Container ID",
        "icon": "$(clippy)",
        "category": "Microservices"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "local-microservices-overlay.refresh",
          "when": "view == microservicesView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "local-microservices-overlay.startContainer",
          "when": "view == microservicesView && viewItem == container-stopped",
          "group": "1_actions@1"
        },
        {
          "command": "local-microservices-overlay.stopContainer",
          "when": "view == microservicesView && viewItem == container-running",
          "group": "1_actions@2"
        },
        {
          "command": "local-microservices-overlay.restartContainer",
          "when": "view == microservicesView && (viewItem == container-running || viewItem == container-stopped)",
          "group": "1_actions@3"
        },
        {
          "command": "local-microservices-overlay.showLogs",
          "when": "view == microservicesView && (viewItem == container-running || viewItem == container-stopped)",
          "group": "2_logs@1"
        },
        {
          "command": "local-microservices-overlay.copyId",
          "when": "view == microservicesView && (viewItem == container-running || viewItem == container-stopped)",
          "group": "3_info@1"
        }
      ]
    },
    "configuration": {
      "title": "Local Microservices Overlay",
      "properties": {
        "localMicroservicesOverlay.pollIntervalSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "maximum": 60,
          "description": "How often (in seconds) to auto-refresh container status."
        },
        "localMicroservicesOverlay.dockerSocketPath": {
          "type": "string",
          "default": "/var/run/docker.sock",
          "description": "Path to the Docker socket. Change only if using a custom socket location."
        },
        "localMicroservicesOverlay.showStoppedContainers": {
          "type": "boolean",
          "default": true,
          "description": "Show stopped/exited containers in the tree view."
        },
        "localMicroservicesOverlay.logTailLines": {
          "type": "number",
          "default": 200,
          "minimum": 10,
          "maximum": 5000,
          "description": "Number of historical log lines to fetch when opening container logs."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.90.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "dockerode": "^5.0.1"
  }
}
